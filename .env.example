# Copia este archivo a .env.local (Vercel/Vite lo ignoran de git automáticamente)
# y llena tu propia key. Nunca subas .env.local a git.

# Motor activo. Empezamos con "gemini" porque su capa gratuita no pide billing.
# Cambiar de motor en el futuro = cambiar esta variable, no reescribir código
# (ver api/_llmProvider.js).
LLM_PROVIDER=gemini

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Verifica el id de modelo vigente en https://ai.google.dev/gemini-api/docs/models
# antes de desplegar — los nombres de modelo de Gemini cambian con frecuencia.
GEMINI_MODEL=gemini-2.5-flash

# --- Claude (opcional, para cuando migres — ver api/_providers/claude.js) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
